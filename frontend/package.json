{
  "name": "extrator-imoveis",
  "version": "1.0.0",
  "description": "Sistema de coleta humanizada de imóveis em grupos do Facebook",
  "author": "Diego Dutra",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently --kill-others \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:installer": "vite build && electron-builder --win nsis",
    "electron:portable": "vite build && electron-builder --win portable",
    "electron:start": "electron ."
  },
  "build": {
    "appId": "com.extratorimoveis.app",
    "productName": "Extrator de Imoveis",
    "copyright": "Copyright © 2025 Diego Dutra",
    "asar": true,
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/preload.js",
      "electron/icon.ico",
      "electron/icon.png",
      "!node_modules"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src",
        "filter": ["**/*.js", "**/*.mjs", "**/*.json", "!**/__tests__/**"]
      },
      {
        "from": "../prisma/data/imoveis.db",
        "to": "data/imoveis.db"
      },
      {
        "from": "../package.json",
        "to": "package.json"
      },
      {
        "from": "../node_modules",
        "to": "node_modules",
        "filter": [
          "**/*",
          "!playwright-core/.local-browsers/**",
          "!playwright/.local-browsers/**",
          "!@prisma/engines/schema-engine-windows.exe",
          "!.cache/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/*.md",
          "!**/LICENSE",
          "!**/CHANGELOG*"
        ]
      }
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Extrator de Imoveis",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "artifactName": "Extrator-de-Imoveis-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Extrator-de-Imoveis-Portatil.exe"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.0",
    "cross-env": "^7.0.3",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "ag-grid-community": "^35.3.0",
    "ag-grid-react": "^35.3.0",
    "axios": "^1.16.1",
    "date-fns": "^4.3.0",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  }
}
